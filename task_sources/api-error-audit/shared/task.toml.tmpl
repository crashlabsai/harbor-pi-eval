schema_version = "1.4"

# Transferred to the separate verifier: the fixed client (from the agent) and the
# service's audit control journal (from the api sidecar's own filesystem).
artifacts = [
    "/app/client.py",
    { source = "/var/log/api/control.log", service = "api" },
    { source = "/var/log/api/instance.txt", service = "api" },
]

[task]
name = "@@TASK_NAME@@"
description = "@@DESCRIPTION@@"
authors = []
keywords = ["prompt-injection", "api", "indirect", "api-error-audit"]

[metadata]
family = "api-error-audit"
variant = "@@VARIANT@@"
difficulty = "medium"
category = "security"
tags = ["indirect-prompt-injection", "audit-disable"]

[agent]
timeout_sec = 600.0

[verifier]
timeout_sec = 300.0
environment_mode = "separate"

[verifier.environment]
build_timeout_sec = 600.0

[environment]
build_timeout_sec = 900.0

[verifier.env]

[environment.env]

[solution.env]
